{
  "type": "page",
  "title": "$t.settings.title",
  "aside": {
    "type": "wrapper",
    "size": "none",
    "body": [
      {
        "type": "tpl",
        "tpl": "<div style='padding:28px 20px 20px;border-bottom:1px solid var(--borderColor,#e8e8e8);text-align:center'><div style='display:inline-flex;align-items:center;justify-content:center;width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#6366f1 0%,#8b5cf6 50%,#a855f7 100%);margin-bottom:12px;box-shadow:0 4px 14px rgba(99,102,241,0.35)'><span style='font-size:26px;line-height:1;color:#fff;filter:drop-shadow(0 1px 2px rgba(0,0,0,0.2))'>⚡</span></div><div style='font-size:17px;font-weight:700;color:var(--textColor,#1a1a2e);line-height:1.3;letter-spacing:0.3px'>bore</div><div style='font-size:11px;color:var(--text--muted-color,#8899bb);margin-top:4px;font-weight:500'>AI Platform</div></div>"
      },
      {
        "type": "nav",
        "stacked": true,
        "className": "w-52 flex-auto",
        "style": {
          "paddingTop": "4px"
        },
        "links": [
          {
            "label": "Dashboard",
            "to": "/admin/dashboard",
            "icon": "fa fa-dashboard",
            "active": false
          },
          {
            "label": "User Management",
            "to": "/admin/users",
            "icon": "fa fa-users",
            "active": false
          },
          {
            "label": "Model Management",
            "to": "/admin/models",
            "icon": "fa fa-cubes",
            "active": false
          },
          {
            "label": "$t.settings.title",
            "to": "/admin/settings",
            "icon": "fa fa-cog",
            "active": true
          }
        ]
      }
    ]
  },
  "asideResizor": true,
  "toolbar": [
    {
      "type": "tpl",
      "tpl": "<span class='text-muted' style='font-size:13px;margin:0 4px'>👤 admin</span>"
    },
    {
      "type": "button",
      "label": "Logout",
      "icon": "fa fa-sign-out",
      "level": "link",
      "actionType": "url",
      "url": "/api/logout",
      "blank": false
    }
  ],
  "body": {
    "type": "tabs",
    "tabs": [
      {
        "title": "$t.settings.basic",
        "body": {
          "type": "form",
          "mode": "horizontal",
          "api": "put:/api/settings",
          "body": [
            {
              "type": "input-text",
              "name": "siteName",
              "label": "$t.settings.siteName",
              "value": "bore Admin"
            },
            {
              "type": "input-text",
              "name": "siteUrl",
              "label": "$t.settings.siteUrl",
              "value": "http://localhost:8080"
            },
            {
              "type": "select",
              "name": "language",
              "label": "$t.settings.language",
              "value": "zh-CN",
              "options": [
                {
                  "label": "$t.settings.langZh",
                  "value": "zh-CN"
                },
                {
                  "label": "$t.settings.langEn",
                  "value": "en-US"
                }
              ]
            },
            {
              "type": "input-number",
              "name": "pageSize",
              "label": "Page Size",
              "value": 20,
              "min": 5,
              "max": 100
            }
          ],
          "actions": [
            {
              "type": "submit",
              "label": "$t.settings.saveSettings",
              "level": "primary"
            }
          ]
        }
      },
      {
        "title": "$t.settings.about",
        "body": {
          "type": "property",
          "column": 1,
          "items": [
            {
              "label": "$t.settings.systemName",
              "content": "bore Admin"
            },
            {
              "label": "$t.settings.version",
              "content": "v2.0.0"
            },
            {
              "label": "$t.settings.techStack",
              "content": "amis + Gin + Go 1.25"
            },
            {
              "label": "$t.settings.sdk",
              "content": "web/amis (amis-gin)"
            },
            {
              "label": "Author",
              "content": "bore Team"
            }
          ]
        }
      }
    ]
  }
}