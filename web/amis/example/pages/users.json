{
  "type": "page",
  "title": "$t.users.title",
  "aside": {
    "type": "wrapper",
    "size": "none",
    "body": [
      {
        "type": "tpl",
        "tpl": "<div style='padding:28px 20px 20px;border-bottom:1px solid var(--borderColor,#e8e8e8);text-align:center'><div style='display:inline-flex;align-items:center;justify-content:center;width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#6366f1 0%,#8b5cf6 50%,#a855f7 100%);margin-bottom:12px;box-shadow:0 4px 14px rgba(99,102,241,0.35)'><span style='font-size:26px;line-height:1;color:#fff;filter:drop-shadow(0 1px 2px rgba(0,0,0,0.2))'>⚡</span></div><div style='font-size:17px;font-weight:700;color:var(--textColor,#1a1a2e);line-height:1.3;letter-spacing:0.3px'>bore</div><div style='font-size:11px;color:var(--text--muted-color,#8899bb);margin-top:4px;font-weight:500'>AI Platform</div></div>"
      },
      {
        "type": "nav",
        "stacked": true,
        "className": "w-52 flex-auto",
        "style": {
          "paddingTop": "4px"
        },
        "links": [
          {
            "label": "Dashboard",
            "to": "/admin/dashboard",
            "icon": "fa fa-dashboard",
            "active": false
          },
          {
            "label": "$t.users.title",
            "to": "/admin/users",
            "icon": "fa fa-users",
            "active": true
          },
          {
            "label": "Model Management",
            "to": "/admin/models",
            "icon": "fa fa-cubes",
            "active": false
          },
          {
            "label": "Settings",
            "to": "/admin/settings",
            "icon": "fa fa-cog",
            "active": false
          }
        ]
      }
    ]
  },
  "asideResizor": true,
  "toolbar": [
    {
      "type": "tpl",
      "tpl": "<span class='text-muted' style='font-size:13px;margin:0 4px'>👤 admin</span>"
    },
    {
      "type": "button",
      "label": "$t.common.logout",
      "icon": "fa fa-sign-out",
      "level": "link",
      "actionType": "url",
      "url": "/api/logout",
      "blank": false
    }
  ],
  "body": {
    "type": "crud",
    "syncLocation": false,
    "api": "/api/users",
    "filter": {
      "body": [
        {
          "type": "input-text",
          "name": "keywords",
          "label": "",
          "placeholder": "$t.users.searchPlaceholder",
          "clearable": true,
          "size": "md"
        }
      ]
    },
    "headerToolbar": [
      {
        "type": "button",
        "label": "$t.users.add",
        "icon": "fa fa-plus",
        "level": "primary",
        "actionType": "dialog",
        "dialog": {
          "title": "$t.users.add",
          "size": "md",
          "body": {
            "type": "form",
            "api": "post:/api/users",
            "body": [
              {
                "type": "input-text",
                "name": "name",
                "label": "$t.table.name",
                "required": true
              },
              {
                "type": "input-email",
                "name": "email",
                "label": "$t.table.email",
                "required": true
              },
              {
                "type": "select",
                "name": "role",
                "label": "$t.table.role",
                "value": "viewer",
                "options": [
                  {
                    "label": "$t.role.admin",
                    "value": "admin"
                  },
                  {
                    "label": "Editor",
                    "value": "editor"
                  },
                  {
                    "label": "Viewer",
                    "value": "viewer"
                  }
                ]
              }
            ]
          }
        }
      },
      {
        "type": "button",
        "label": "$t.common.batchDelete",
        "icon": "fa fa-trash",
        "level": "danger",
        "actionType": "ajax",
        "api": "delete:/api/users/${ids|raw}",
        "confirmText": "$t.users.confirmDelete",
        "visibleOn": "this.ids && this.ids.length"
      }
    ],
    "footerToolbar": [
      "statistics",
      "pagination"
    ],
    "columns": [
      {
        "name": "id",
        "label": "$t.label.id",
        "width": 60
      },
      {
        "name": "name",
        "label": "$t.table.name",
        "searchable": true
      },
      {
        "name": "email",
        "label": "$t.table.email"
      },
      {
        "name": "role",
        "label": "$t.table.role",
        "type": "mapping",
        "map": {
          "admin": "<span class='label label-primary'>Admin</span>",
          "editor": "<span class='label label-info'>Editor</span>",
          "viewer": "<span class='label label-default'>Viewer</span>"
        }
      },
      {
        "type": "operation",
        "label": "Action",
        "width": 160,
        "buttons": [
          {
            "type": "button",
            "label": "Editor",
            "level": "link",
            "actionType": "dialog",
            "dialog": {
              "title": "$t.users.edit",
              "body": {
                "type": "form",
                "api": "put:/api/users/${id}",
                "body": [
                  {
                    "type": "input-text",
                    "name": "name",
                    "label": "$t.table.name"
                  },
                  {
                    "type": "input-email",
                    "name": "email",
                    "label": "$t.table.email"
                  },
                  {
                    "type": "select",
                    "name": "role",
                    "label": "$t.table.role",
                    "options": [
                      {
                        "label": "$t.role.admin",
                        "value": "admin"
                      },
                      {
                        "label": "Editor",
                        "value": "editor"
                      },
                      {
                        "label": "Viewer",
                        "value": "viewer"
                      }
                    ]
                  }
                ]
              }
            }
          },
          {
            "type": "button",
            "label": "$t.common.delete",
            "level": "link",
            "className": "text-danger",
            "actionType": "ajax",
            "api": "delete:/api/users/${id}",
            "confirmText": "Confirm delete?"
          }
        ]
      }
    ]
  }
}